import { useEffect, useMemo, useState, type MouseEvent } from 'react';
import {
  ArrowDown, ArrowUp, ArrowUpRight, BriefcaseBusiness, Cloud,
  Cpu, Globe2, GraduationCap, Layers3, Mail, Menu, Network, Quote, Router,
  Send, Sparkles, Trophy, Volume2, VolumeX,
  Users, X, Zap,
} from 'lucide-react';

type Chapter = {
  id: string;
  label: string;
};

const chapters: Chapter[] = [
  { id: 'home', label: 'Home' },
  { id: 'about', label: 'About' },
  { id: 'skills', label: 'Skills' },
  { id: 'experience', label: 'Experience' },
  { id: 'leadership', label: 'Leadership' },
  { id: 'projects', label: 'Projects' },
  { id: 'certifications', label: 'Certificates' },
  { id: 'future', label: 'Future' },
  { id: 'contact', label: 'Contact' },
];

const skillGroups = [
  {
    number: '01', title: 'Technology', icon: Network, accent: 'line-red',
    items: ['Networking', 'IT support', 'Cloud computing', 'Linux', 'IoT', 'Cybersecurity fundamentals', 'Fiber optics', 'CCTV', 'Switching & routing', 'Troubleshooting'],
  },
  {
    number: '02', title: 'Digital & practical', icon: Cpu, accent: 'line-gold',
    items: ['Smart systems', 'Sensors', 'Automation', 'Web technologies', 'Database technologies', 'Digital technologies', 'Embedded systems'],
  },
  {
    number: '03', title: 'Customer & business', icon: Users, accent: 'line-cream',
    items: ['Customer service', 'Customer engagement', 'Sales fundamentals', 'Active listening', 'Complaint handling', 'Data entry', 'Rapid typing', 'Attention to detail'],
  },
  {
    number: '04', title: 'Leadership & communication', icon: Quote, accent: 'line-red',
    items: ['Leadership', 'Public speaking', 'Debate', 'Presentation', 'Teamwork', 'Coordination', 'Communication', 'Problem-solving', 'Critical thinking'],
  },
];

const certifications = [
  'Leadership Essentials — NonprofitReady.org',
  'EF SET English Certificate — B2 Upper-Intermediate',
  'Managing Your Time — LinkedIn Learning',
  'Cisco Network Security, Secure Routing & Switching — LinkedIn Learning',
  'Project Management for Foundations / Requirements — LinkedIn Learning',
  'Communication Skills — SkillUp',
  'Effective Leadership — HP LIFE',
  'iDebate Rwanda certificates',
  'Harambee Youth Employment Accelerator Work Readiness Program',
];

function App() {
  const [activeChapter, setActiveChapter] = useState('home');
  const [navOpen, setNavOpen] = useState(false);
  const [photoOffset, setPhotoOffset] = useState({ x: 0, y: 0 });
  const [isSpeaking, setIsSpeaking] = useState(false);

  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActiveChapter(visible.target.id);
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0.05, 0.2, 0.5] },
    );
    chapters.forEach(({ id }) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
    return () => observer.disconnect();
  }, []);

  useEffect(() => {
    const revealObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('is-visible')),
      { threshold: 0.12 },
    );
    document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
    return () => revealObserver.disconnect();
  }, []);

  const activeIndex = useMemo(() => chapters.findIndex((chapter) => chapter.id === activeChapter), [activeChapter]);

  const handleMouseMove = (event: MouseEvent<HTMLDivElement>) => {
    const bounds = event.currentTarget.getBoundingClientRect();
    setPhotoOffset({
      x: ((event.clientX - bounds.left) / bounds.width - 0.5) * 12,
      y: ((event.clientY - bounds.top) / bounds.height - 0.5) * 10,
    });
  };

  const scrollTo = (id: string) => {
    document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
    setNavOpen(false);
  };

  const speakIntroduction = () => {
    if (!('speechSynthesis' in window)) return;
    if (isSpeaking) {
      window.speechSynthesis.cancel();
      setIsSpeaking(false);
      return;
    }
    const introduction = new SpeechSynthesisUtterance('Hi, my name is Ngenzi Levique. Welcome to my portfolio website.');
    introduction.rate = 0.92;
    introduction.pitch = 1;
    introduction.onend = () => setIsSpeaking(false);
    introduction.onerror = () => setIsSpeaking(false);
    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(introduction);
    setIsSpeaking(true);
  }; 

  return (
    <main className="site-shell">
      <div className="chapter-progress" aria-hidden="true">
        <span style={{ height: `${Math.max(10, ((activeIndex + 1) / chapters.length) * 100)}%` }} />
      </div>
      <header className={`site-nav ${activeChapter === 'home' || activeChapter === 'future' || activeChapter === 'contact' ? 'nav-light' : 'nav-dark'}`}>
        <button className="brand-mark" onClick={() => scrollTo('home')} aria-label="Back to home">
          <span>NL</span><small>PORTFOLIO / 2026</small>
        </button>
        <button className="menu-toggle" onClick={() => setNavOpen((open) => !open)} aria-label="Toggle navigation">
          {navOpen ? <X size={20} /> : <Menu size={20} />}
        </button>
        <nav className={navOpen ? 'nav-links open' : 'nav-links'}>
          {chapters.map((chapter) => (
            <button className={activeChapter === chapter.id ? 'active' : ''} key={chapter.id} onClick={() => scrollTo(chapter.id)}>
              {chapter.label}
            </button>
          ))}
        </nav>
        <a className="nav-contact" href="mailto:ngenzilevique@gmail.com">Get in touch <ArrowUpRight size={15} /></a>
      </header>

      <section id="home" className="hero chapter-cream">
        <div className="hero-grain" />
        <div className="hero-orbit orbit-one" /><div className="hero-orbit orbit-two" />
        <div className="hero-copy">
          <p className="eyebrow reveal"><span className="eyebrow-line" /> A personal digital journey</p>
          <h1 className="hero-title reveal delay-one">Ngenzi<br /><em>Levique</em></h1>
          <p className="hero-role reveal delay-two">Level 5 Networking &amp; Internet Technology Graduate</p>
          <p className="hero-intro reveal delay-two">Curious about how things connect. Focused on learning, solving problems, and creating useful solutions that move people and technology forward.</p>
          <button className="text-button reveal delay-three" onClick={() => scrollTo('about')}>Enter the story <ArrowDown size={17} /></button>
        </div>
        <div className="hero-portrait-area reveal delay-one" onMouseMove={handleMouseMove} onMouseLeave={() => setPhotoOffset({ x: 0, y: 0 })}>
          <div className="portrait-halo" />
          <div className="portrait-caption"><span>01 / 05</span><span>THE BEGINNING</span></div>
          <div className={isSpeaking ? 'portrait-frame speaking' : 'portrait-frame'} style={{ transform: `perspective(1000px) rotateY(${photoOffset.x * 0.22}deg) rotateX(${-photoOffset.y * 0.16}deg)` }}>
            <div className="portrait-light" />
            <img src="/images/WhatsApp_Image_2026-10-04_at_11.00.39_PM.jpeg" alt="Ngenzi Levique seated at a desk" style={{ transform: `translate3d(${photoOffset.x * 0.18}px, ${photoOffset.y * 0.14}px, 0) scale(1.12)` }} />
            <div className="portrait-blink blink-left" aria-hidden="true" /><div className="portrait-blink blink-right" aria-hidden="true" />
            <div className="portrait-mouth" aria-hidden="true" />
            <div className={isSpeaking ? 'talking-wave active' : 'talking-wave'} aria-hidden="true"><i /><i /><i /><i /><i /></div>
          </div>
          <div className="portrait-note">Technology is a way<br />of making ideas useful.</div>
          <div className="portrait-speech" aria-live="polite">“Hi, my name is Ngenzi Levique. Welcome to my portfolio website.”</div>
          <button className={isSpeaking ? 'voice-button speaking' : 'voice-button'} onClick={speakIntroduction} aria-label={isSpeaking ? 'Stop introduction' : 'Play introduction'}>
            {isSpeaking ? <VolumeX size={15} /> : <Volume2 size={15} />}<span>{isSpeaking ? 'Speaking' : 'Hear my introduction'}</span>
          </button>
        </div>
        <div className="hero-side-label">Scroll to explore <span>↓</span></div>
      </section>

      <section id="about" className="chapter-black chapter-padding">
        <div className="section-kicker reveal"><span>02</span><span>About me</span></div>
        <div className="about-grid">
          <h2 className="display-heading reveal">Learning is<br /><span>the constant.</span></h2>
          <div className="about-copy reveal delay-one">
            <p className="large-copy">I am a Level 5 graduate in <strong>Networking and Internet Technology</strong> from the International Technical School of Kigali.</p>
            <p>My path brings together practical technology, communication, leadership, and a genuine interest in people. From networking infrastructure and cloud systems to debate rooms and customer conversations, I enjoy understanding the problem before building the answer.</p>
            <p>I am adaptable, resilient, detail-oriented, and motivated by opportunities to keep growing through hands-on work and collaboration.</p>
            <div className="signature-line"><span /> <em>Ngenzi Levique</em></div>
          </div>
        </div>
        <div className="about-trail reveal">
          <div><span>2024—25</span><strong>Natcom Academy</strong><small>Practical internship</small></div>
          <div><span>2026</span><strong>ITS Kigali</strong><small>Level 5 graduate</small></div>
          <div><span>Next</span><strong>Keep building</strong><small>Learning in motion</small></div>
        </div>
      </section>

      <section id="skills" className="chapter-charcoal chapter-padding">
        <div className="section-kicker light reveal"><span>03</span><span>Technical journey</span></div>
        <div className="section-intro reveal"><h2 className="display-heading">Many tools.<br /><span>One mindset.</span></h2><p>Technology is never just a checklist. It is the practice of staying curious, patient, and useful when systems or situations get complicated.</p></div>
        <div className="skill-grid">
          {skillGroups.map((group) => { const Icon = group.icon; return <article className="skill-group reveal" key={group.number}><div className="skill-top"><span>{group.number}</span><Icon size={21} strokeWidth={1.5} /></div><h3>{group.title}</h3><div className={`skill-rule ${group.accent}`} /> <ul>{group.items.map((item) => <li key={item}>{item}</li>)}</ul></article>; })}
        </div>
      </section>

      <section id="experience" className="chapter-red chapter-padding">
        <div className="section-kicker light reveal"><span>04</span><span>Experience</span></div>
        <div className="red-heading-row"><h2 className="display-heading reveal">Where theory<br /><span>met reality.</span></h2><p className="reveal delay-one">Hands-on environments taught me to be dependable, attentive, and ready to learn from every task.</p></div>
        <div className="experience-list">
          <article className="experience-item reveal"><div className="experience-year">2024—25</div><div><p className="item-label">Natcom Academy</p><h3>Level 3 &amp; Level 4 Internship</h3><p>Completed a two-year practical internship covering networking, communication technologies, and hands-on technical work.</p><div className="tag-row"><span>Networking infrastructure</span><span>Cisco routing &amp; switching</span><span>Fiber-optic installation</span><span>CCTV</span></div></div><BriefcaseBusiness size={24} /></article>
          <article className="experience-item reveal"><div className="experience-year">2026</div><div><p className="item-label">Bridge / Unipod / KIST</p><h3>Level 5 Practical Experience</h3><p>Worked with cloud computing, Linux, IoT implementation, cybersecurity fundamentals, penetration-testing fundamentals, and technical troubleshooting.</p><div className="tag-row"><span>Cloud</span><span>Linux</span><span>IoT</span><span>Cybersecurity</span></div></div><Router size={24} /></article>
          <article className="experience-item reveal"><div className="experience-year">21—25<br />SEP 2026</div><div><p className="item-label">Harambee Youth Employment Accelerator</p><h3>Work Readiness Program · GBO Sector</h3><p>Built customer service, sales, complaint handling, rapid typing, teamwork, self-management, resilience, initiative, and professional communication skills.</p><div className="tag-row"><span>Customer engagement</span><span>Active listening</span><span>Workplace collaboration</span></div></div><Zap size={24} /></article>
        </div>
      </section>

      <section id="leadership" className="chapter-burgundy chapter-padding">
        <div className="section-kicker light reveal"><span>05</span><span>Leadership</span></div>
        <div className="leadership-layout"><div><h2 className="display-heading reveal">Find your voice.<br /><span>Bring others with you.</span></h2><p className="leadership-quote reveal delay-one">“Leadership, to me, is the courage to contribute — then make room for others to do the same.”</p></div><div className="leadership-cards"><div className="leadership-card reveal"><span>Coordinator</span><strong>PLP Inganji</strong><p>Recruitment, member engagement, rules, coordination, and shared objectives.</p></div><div className="leadership-card reveal delay-one"><span>Advisor</span><strong>ITS YoungLife Club</strong><p>Guidance, collaboration, communication, teamwork, and interpersonal skills.</p></div><div className="leadership-card feature reveal delay-two"><Trophy size={25} /><strong>Debate Club Lead</strong><p>Organized events, trained new members, and helped build communication and public-speaking confidence.</p><b>2 trophies <i>·</i> 6 gold medals</b></div></div></div>
      </section>

      <section id="projects" className="chapter-warm chapter-padding">
        <div className="section-kicker reveal"><span>06</span><span>Projects &amp; activities</span></div>
        <div className="project-heading"><h2 className="display-heading reveal">Build. Test.<br /><span>Make it real.</span></h2><p className="reveal delay-one">A practical curiosity spanning connected systems, digital tools, innovation challenges, and collaborative problem-solving.</p></div>
        <div className="project-mosaic">
          <article className="project-tile tile-large reveal"><div className="tile-icon"><Layers3 /></div><span>01 / Systems</span><h3>Smart systems<br />&amp; connected things</h3><p>IoT systems, smart-home technologies, sensors, embedded systems, automation, and real-world technology problem solving.</p></article>
          <article className="project-tile tile-dark reveal delay-one"><div className="tile-icon"><Cloud /></div><span>02 / Infrastructure</span><h3>Cloud, Linux<br />&amp; cybersecurity</h3><p>Practical exposure to cloud computing, Linux, security fundamentals, and technical troubleshooting.</p></article>
          <article className="project-tile tile-outline reveal delay-two"><div className="tile-icon"><Sparkles /></div><span>03 / Innovation</span><h3>Competitions<br />&amp; collaboration</h3><p>FIRST LEGO League 2025, REMA Tech Hackathon, district-level hackathon activities, and Codex technology initiatives.</p></article>
        </div>
      </section>

      <section id="certifications" className="chapter-black chapter-padding certification-section">
        <div className="section-kicker light reveal"><span>07</span><span>Learning archive</span></div>
        <div className="cert-layout"><div><h2 className="display-heading reveal">Proof of<br /><span>the practice.</span></h2><p className="reveal delay-one">Every certificate marks a decision to keep learning — across technology, communication, leadership, and professional growth.</p><div className="education-stamp reveal delay-two"><GraduationCap size={25} /><span>ITS Kigali</span><strong>Level 5 · Networking &amp; Internet Technology</strong><small>Graduate — 2026</small></div></div><div className="cert-list reveal delay-one">{certifications.map((certificate, index) => <div className="cert-row" key={certificate}><span>{String(index + 1).padStart(2, '0')}</span><p>{certificate}</p><ArrowUpRight size={16} /></div>)}</div></div>
        <div className="languages reveal"><span>Languages</span><div><b>Kinyarwanda</b><small>Native / Fluent</small></div><div><b>English</b><small>B2 Upper-Intermediate</small></div><div><b>French</b><small>Basic</small></div></div>
      </section>

      <section id="future" className="chapter-cream future-section chapter-padding">
        <div className="future-glow" /><div className="section-kicker reveal"><span>08</span><span>Global exposure · What’s next</span></div>
        <div className="future-layout"><div><p className="eyebrow reveal"><span className="eyebrow-line" /> The next horizon</p><h2 className="display-heading reveal delay-one">Still becoming<br /><span>what’s possible.</span></h2><p className="future-copy reveal delay-two">I am a young technology professional continuing to learn, build, collaborate, and grow — with the ambition to create digital solutions that are useful, thoughtful, and built to last.</p><button className="text-button dark reveal delay-three" onClick={() => scrollTo('contact')}>Start a conversation <ArrowUpRight size={17} /></button></div><div className="global-card reveal delay-one"><Globe2 size={27} /><span>Global exposure</span><strong>Global Space Connectivity &amp; Sustainability Events</strong><p>Participant — Ngenzi Levique</p><small>12–14 October 2026<br />CST Headquarters, Riyadh, Saudi Arabia</small></div></div>
      </section>

      <footer id="contact" className="contact-footer">
        <div className="section-kicker light reveal"><span>09</span><span>Contact</span></div><div className="footer-main"><div><p className="eyebrow light reveal"><span className="eyebrow-line" /> Let’s connect</p><h2 className="footer-title reveal delay-one">Let’s make<br /><em>something useful.</em></h2></div><div className="contact-details reveal delay-two"><a href="mailto:ngenzilevique@gmail.com"><Mail size={18} /> ngenzilevique@gmail.com <ArrowUpRight size={15} /></a><a href="tel:+250791376727"><Send size={18} /> +250 791 376 727 <ArrowUpRight size={15} /></a><p>Available for meaningful conversations, opportunities to learn, and work that turns technology into practical value.</p></div></div><div className="footer-bottom"><span>NGENZI LEVIQUE</span><small>Not just a CV. A journey in motion.</small><button onClick={() => scrollTo('home')} aria-label="Back to top"><ArrowUp size={16} /></button></div>
      </footer>
    </main>
  );
}

export default App;
